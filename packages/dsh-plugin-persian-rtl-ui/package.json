{
  "name": "dsh-plugin-persian-rtl-ui",
  "version": "1.0.0",
  "description": "Right-aligns Persian prose in the DSH Web GUI: detects Persian blocks, sets their text direction, and keeps code and inputs LTR.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persian",
    "farsi",
    "rtl",
    "bidi"
  ],
  "license": "MIT",
  "author": "saeid600305-beep",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeid600305-beep/dsh-persian-rtl.git",
    "directory": "packages/dsh-plugin-persian-rtl-ui"
  },
  "homepage": "https://github.com/saeid600305-beep/dsh-persian-rtl#readme",
  "bugs": {
    "url": "https://github.com/saeid600305-beep/dsh-persian-rtl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
