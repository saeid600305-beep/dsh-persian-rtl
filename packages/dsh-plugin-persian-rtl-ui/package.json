{
  "name": "dsh-plugin-persian-rtl-ui",
  "version": "1.0.0",
  "description": "Right-aligns Persian prose in the DSH Web GUI: detects Persian blocks, sets their text direction, and keeps code and inputs LTR.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "persian",
    "rtl",
    "bidi",
    "web"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
